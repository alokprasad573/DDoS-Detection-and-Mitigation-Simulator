# ==============================================================================
# SENTRIX - Production & Development Environment Configuration
# Architecture:
#   - Backend: Render Web Service (FastAPI + ML Engine)
#   - Database: Supabase Managed PostgreSQL (DATABASE_URL)
#   - Frontend: Vercel Serverless (Next.js 16 Web Dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Core Service Settings (Render Web Service)
# ------------------------------------------------------------------------------

# Application Environment: 'development' | 'staging' | 'production'
APP_ENV=production

# Server Port (assigned dynamically by Render as $PORT; defaults to 8000 locally)
PORT=8000

# Defense Mitigation Mode:
#   - simulation : Synthetically evaluates drop rates in safe memory sandbox (default)
#   - dry_run    : Logs proposed firewall rules without dropping live packets
#   - active     : Actively drops or rate-limits matching attack traffic
MITIGATION_MODE=simulation

# Primary Approved Machine Learning Model Path:
MODEL_PATH=models/approved_model.joblib

# ------------------------------------------------------------------------------
# 2. Database Connection (Supabase Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Copy from Supabase Project Settings -> Database -> Connection String (URI).
# 
# Option A: Supabase Connection Pooler (Recommended for Render - IPv4 compatible):
# Note: Use port 6543 (Transaction Mode) or 5432 (Session Mode).
# DATABASE_URL=postgresql+psycopg2://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Supabase Direct Connection:
# DATABASE_URL=postgresql+psycopg2://postgres:[your-password]@db.[your-project-ref].supabase.co:5432/postgres?sslmode=require
#
# Option C: Local Development SQLite:
DATABASE_URL=sqlite:///./sentrix.db

# NOTE ON SPECIAL CHARACTERS IN SUPABASE PASSWORD:
# If your Supabase database password contains special characters (e.g., '@', '#', '%', '$', ':'),
# URL-encode them (e.g. '@' becomes '%40', '#' becomes '%23') or set an alphanumeric password.

# ------------------------------------------------------------------------------
# 3. Security & Authentication Gate
# ------------------------------------------------------------------------------

# When true, all protected endpoints require 'Authorization: Bearer <token>'
API_AUTH_REQUIRED=true

# API Authentication Secret Token:
# Must match between backend (API_AUTH_TOKEN) and frontend (API_AUTH_TOKEN / NEXT_PUBLIC_API_TOKEN).
API_AUTH_TOKEN=generate-random

# Supabase Anti-Pausing Keepalive Secret:
# Dedicated key for /internal/keepalive endpoint to prevent Supabase Free Tier auto-pausing.
# Ping periodically with header: Authorization: Bearer <KEEPALIVE_SECRET>
KEEPALIVE_SECRET=generate-random

# Allowed CORS Origins (comma-separated):
# Note: All *.vercel.app domains are automatically allowed by regex in backend/app/main.py.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. Frontend Web Interface Settings (Vercel Next.js 16)
# ------------------------------------------------------------------------------

# Node Environment
NODE_ENV=production

# Server-Side Backend URL (used by Vercel Next.js /api/proxy route):
# Set this in your Vercel Project Environment Variables to your Render backend URL.
BACKEND_URL=https://sentrix-backend.onrender.com

# Next.js Server-Side Proxy Mode:
# When true, browser requests route through '/api/proxy/...', keeping credentials safe.
NEXT_PUBLIC_USE_PROXY=true

# Direct Client Backend Connection (used when NEXT_PUBLIC_USE_PROXY=false)
NEXT_BACKEND_API_URL=http://127.0.0.1:8000
NEXT_API_AUTH_TOKEN=generate-random

# Canonical Public Web URL (e.g., https://sentrix.vercel.app):
NEXT_PUBLIC_APP_URL=https://sentrix.security
