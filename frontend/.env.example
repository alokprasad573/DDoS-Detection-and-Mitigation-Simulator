# ==============================================================================
# SENTRIX Frontend Environment Configuration Template
# ==============================================================================

# 1. Direct Backend Connection (Used when NEXT_PUBLIC_USE_PROXY=false)
# Local: http://127.0.0.1:8000 | Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Client-Side Bearer Authentication Token (must match backend API_AUTH_TOKEN)
NEXT_PUBLIC_API_TOKEN=7c4e9f2b1a8d3f6cf1b2c3d4e5f60789

# 2. Next.js Server-Side Proxy Configuration (Recommended for Docker & Vercel)
# When true, browser requests route through '/api/proxy/[...path]' avoiding CORS
NEXT_PUBLIC_USE_PROXY=true

# Server-Side Backend Target URL (used only on the server)
# Local: http://127.0.0.1:8000 | Docker: http://backend:8000 | Vercel: https://your-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# Server-Side API Bearer Auth Token (injected securely into proxied backend requests)
API_AUTH_TOKEN=7c4e9f2b1a8d3f6cf1b2c3d4e5f60789

# 3. Canonical App URL (Used for Metadata and OpenGraph)
NEXT_PUBLIC_APP_URL=https://sentrix.security
