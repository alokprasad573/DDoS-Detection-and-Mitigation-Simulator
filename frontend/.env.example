# ==============================================================================
# SENTRIX Frontend Environment Configuration Template
# ==============================================================================

# 1. Next.js Server-Side Proxy Configuration (Recommended for Docker & Vercel)
# When true, browser requests route through '/api/proxy/[...path]' avoiding CORS
NEXT_PUBLIC_USE_PROXY=true

# Server-Side Backend Target URL (used only on the server by Next.js proxy)
# Local: http://127.0.0.1:8000 | Production: https://your-backend.onrender.com
BACKEND_URL=https://your-backend.onrender.com

# Server-Side API Bearer Auth Token (injected securely into proxied backend requests)
API_AUTH_TOKEN=generate-random-token

# 2. Direct Backend Connection (Used if NEXT_PUBLIC_USE_PROXY=false)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
NEXT_BACKEND_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_API_TOKEN=generate-random-token
NEXT_API_AUTH_TOKEN=generate-random-token

# 3. Canonical App URL (Used for Metadata and OpenGraph)
NEXT_PUBLIC_APP_URL=https://sentrix.security
