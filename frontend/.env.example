# SENTRIX Frontend Environment Configuration
# Local Development: http://127.0.0.1:8000
# Production (Vercel): https://<your-render-app>.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API Bearer Authentication Token (must match backend API_AUTH_TOKEN)
NEXT_PUBLIC_API_TOKEN=genetated-api-auth-token



  